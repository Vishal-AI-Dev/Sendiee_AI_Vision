# ─── Database (MongoDB Atlas for vector search; local MongoDB works for everything else)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sendiee_vision

# ─── Admin login (next-auth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<openssl rand -base64 32>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Image embeddings (Jina)
JINA_API_KEY=
# jina-clip-v2 (default) or jina-embeddings-v5-omni-small — both 1024 dims. Re-embed the catalogue if you switch.
JINA_MODEL=jina-clip-v2
EMBEDDING_DIMENSIONS=1024

# ─── Reference image storage (Supabase Storage; bucket should be public-read)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products

# ─── Optional: double-check stage for the precise flow (OpenAI Decisions API, beta)
OPENAI_API_KEY=
