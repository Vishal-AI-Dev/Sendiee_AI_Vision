# ─── Database (MongoDB Atlas for vector search; local MongoDB works for everything else)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sendiee_vision

# ─── Admin login (next-auth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<openssl rand -base64 32>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Image embeddings (Jina)
JINA_API_KEY=
# jina-clip-v2 (default) or jina-embeddings-v5-omni-small — both 1024 dims. Re-embed the catalogue if you switch.
JINA_MODEL=jina-clip-v2
EMBEDDING_DIMENSIONS=1024

# ─── Reference image storage (Supabase Storage; bucket should be public-read)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products

# ─── Optional: double-check stage for the precise flow (OpenAI Decisions API, beta)
OPENAI_API_KEY=

# ─── Photo preprocessing (optional; defaults shown)
# Longest side sent to the embedding model / to the double-check model
EMBED_MAX_SIDE=512
TIEBREAK_MAX_SIDE=1024
# Quality gate: variance of the Laplacian below this = blurry (smooth white products score ~35 in focus, heavy blur <5)
QUALITY_BLUR_FLOOR=12
# Mean luminance (0–255) outside this band = too dark / washed out; shortest side below this = too small
QUALITY_DARK_FLOOR=40
QUALITY_BRIGHT_CEIL=235
QUALITY_MIN_SIDE=200
